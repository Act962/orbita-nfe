{
  "name": "orbita-nfe",
  "version": "0.1.0",
  "description": "Motor fiscal brasileiro - NFS-e, NFC-e e NF-e",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run deps && npm test",
    "dev:api": "tsx watch src/main/api.ts",
    "spikes": "vitest run --config vitest.spikes.config.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "node-forge": "^1.4.3",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "undici": "^8.12.4",
    "xml-crypto": "^6.4.0",
    "xmllint-wasm": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
