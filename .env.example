# Copie para .env apenas em desenvolvimento. Em produção, as variáveis vêm do Coolify.
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Tamanho máximo do corpo das requisições, em bytes
HTTP_BODY_LIMIT=1048576
# Documentação da API: Scalar em /docs/, OpenAPI em /openapi.json, índice para agentes em /llms.txt, guias em /guides/
API_DOCS_ENABLED=true

# Aplicação: SEMPRE um usuário de login membro de fiscal_api (nunca o dono das tabelas)
DATABASE_URL=postgres://app_api:dev-only-password@127.0.0.1:15432/orbita_nfe
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Migrations: dono das tabelas (sem superuser). Usado só por `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgres://fiscal_owner:dev-only-password@127.0.0.1:15432/orbita_nfe

# Pepper das API keys: caminho de um ARQUIVO (gere com `npm run dev:secrets`). Nunca o valor em variável.
API_KEY_PEPPER_FILE=secrets/api-key-pepper

# CLI do operador (`npm run iam -- ...`): usuário de login membro de fiscal_admin. Não vai para o container da API.
ADMIN_DATABASE_URL=postgres://app_admin:dev-only-password@127.0.0.1:15432/orbita_nfe

# KEK PÚBLICA dos certificados A1 (RSA 4096, PEM). A API só cifra (ADR-0009). Gere em dev com `npm run dev:secrets`.
CERTIFICATE_KEK_PUBLIC_FILE=secrets/certificate-kek-public.pem
# A KEK PRIVADA fica SÓ no worker-fiscal (e na CLI `npm run certificates`); nunca defina CERTIFICATE_KEK_PRIVATE_FILE na API.
WORKER_CERTIFICATE_KEK_PRIVATE_FILE=secrets/certificate-kek-private.pem
# Bundle das ACs raiz confiáveis (PEM). Produção: ACs raiz ICP-Brasil publicadas pelo ITI (docs/runbooks/kek-certificados.md).
CERTIFICATE_TRUST_BUNDLE_FILE=secrets/trust-bundle.pem
# Worker fiscal / CLI de certificados: usuário de login membro de fiscal_worker.
WORKER_DATABASE_URL=postgres://app_worker:dev-only-password@127.0.0.1:15432/orbita_nfe

# Chave PÚBLICA dos segredos de webhook (RSA 4096, PEM): a API cifra o segredo e não o lê de volta (ADR-0021).
WEBHOOK_SECRET_KEY_PUBLIC_FILE=secrets/webhook-secret-key-public.pem
# Destinos http/privados nas assinaturas: SÓ desenvolvimento (recusado em produção, proteção contra SSRF).
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
# Limite por credencial e por endereço (ADR-0026).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120

# worker-general (outbox e webhooks): login membro de fiscal_general + chave PRIVADA dos segredos de webhook.
# Em produção, nenhum outro container recebe esta chave.
GENERAL_DATABASE_URL=postgres://app_general:dev-only-password@127.0.0.1:15432/orbita_nfe
GENERAL_WEBHOOK_SECRET_KEY_PRIVATE_FILE=secrets/webhook-secret-key-private.pem
WEBHOOK_TIMEOUT_MS=10000

# Workers (fiscal e general)
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
JOB_RETENTION_DAYS=7
# Autorizador da NFS-e no worker-fiscal: none (filas nfse.* paradas), simulator (autorizador
# SIMULADO em memória; recusado em produção) ou sefin (SEFIN Nacional REAL, só produção restrita,
# com o certificado A1 do estabelecimento; ADR-0038).
NFSE_GATEWAY=simulator

# Âncora externa da auditoria (ADR-0031): bucket S3 com Object Lock. Obrigatória em produção no
# worker-general (credencial de ESCRITA) e usada pelo operador em `npm run audit -- verify --anchor`
# (credencial de LEITURA). Em dev: SeaweedFS local + `npm run dev:object-storage`.
AUDIT_ANCHOR_S3_ENDPOINT=http://127.0.0.1:8333
AUDIT_ANCHOR_S3_REGION=us-east-1
AUDIT_ANCHOR_S3_BUCKET=orbita-audit-anchors-dev
AUDIT_ANCHOR_S3_FORCE_PATH_STYLE=true
AUDIT_ANCHOR_S3_ACCESS_KEY_ID_FILE=secrets/anchor-s3-access-key-id
AUDIT_ANCHOR_S3_SECRET_ACCESS_KEY_FILE=secrets/anchor-s3-secret-access-key
AUDIT_ANCHOR_RETENTION_DAYS=1
