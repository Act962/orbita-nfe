# Copie para .env apenas em desenvolvimento. Em produção, as variáveis vêm do Coolify.
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Tamanho máximo do corpo das requisições, em bytes
HTTP_BODY_LIMIT=1048576
# Documentação da API (Scalar em /docs/, OpenAPI em /docs/openapi.json)
API_DOCS_ENABLED=true

# Aplicação: SEMPRE um usuário de login membro de fiscal_api (nunca o dono das tabelas)
DATABASE_URL=postgres://app_api:dev-only-password@127.0.0.1:15432/orbita_nfe
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Migrations: dono das tabelas (sem superuser). Usado só por `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgres://fiscal_owner:dev-only-password@127.0.0.1:15432/orbita_nfe

# Pepper das API keys: caminho de um ARQUIVO (gere com `npm run dev:secrets`). Nunca o valor em variável.
API_KEY_PEPPER_FILE=secrets/api-key-pepper

# CLI do operador (`npm run iam -- ...`): usuário de login membro de fiscal_admin. Não vai para o container da API.
ADMIN_DATABASE_URL=postgres://app_admin:dev-only-password@127.0.0.1:15432/orbita_nfe

# KEK PÚBLICA dos certificados A1 (RSA 4096, PEM). A API só cifra (ADR-0009). Gere em dev com `npm run dev:secrets`.
CERTIFICATE_KEK_PUBLIC_FILE=secrets/certificate-kek-public.pem
# A KEK PRIVADA fica SÓ no worker-fiscal (e na CLI `npm run certificates`); nunca defina CERTIFICATE_KEK_PRIVATE_FILE na API.
WORKER_CERTIFICATE_KEK_PRIVATE_FILE=secrets/certificate-kek-private.pem
# Bundle das ACs raiz confiáveis (PEM). Produção: ACs raiz ICP-Brasil publicadas pelo ITI (docs/runbooks/kek-certificados.md).
CERTIFICATE_TRUST_BUNDLE_FILE=secrets/trust-bundle.pem
# Worker fiscal / CLI de certificados: usuário de login membro de fiscal_worker.
WORKER_DATABASE_URL=postgres://app_worker:dev-only-password@127.0.0.1:15432/orbita_nfe
